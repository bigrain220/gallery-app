<import src="../../templates/bookings.wxml" />
<page-meta page-style="overflow: {{view === 'main' && !showPolicy ? 'auto' : 'hidden'}};"></page-meta>
<view class="app-shell">
  <view wx:if="{{showStartupLoading}}" class="page-body loading-page startup-loading {{startupLoadingFading ? 'startup-loading--fading' : ''}}" catchtap="noop" catchtouchmove="noop">
    <image class="loading-art" src="/assets/loading.png" mode="aspectFill" bindload="onStartupArtReady" binderror="onStartupArtReady" aria-label="GUCCI BY TOM FORD"></image>
  </view>
  <view wx:if="{{view === 'loading' && !showStartupLoading}}" class="page-body booking-check-page">
    <text>正在确认预约状态…</text>
  </view>

  <view class="main-scroll {{view !== 'main' ? 'main-scroll--inactive' : ''}}">
    <view class="main-content">
      <image
        wx:for="{{[activity.coverUrl || activity.exhibitUrl || '/assets/exhibition.jpg']}}"
        wx:key="*this"
        class="exhibition-art"
        src="{{item}}"
        data-src="{{item}}"
        mode="widthFix"
        bindload="onHomeCoverReady"
        binderror="onHomeCoverReady"
      ></image>

      <view class="event-intro">
        <image wx:if="{{activity.titleUrl}}" class="event-title-image" src="{{activity.titleUrl}}" mode="widthFix"></image>
        <image wx:else class="event-title-image" src="/assets/title.png" mode="widthFix"></image>
        <view wx:if="{{activity.openTime && activity.closeTime && (activity.openTime !== '11:00' || activity.closeTime !== '20:00')}}" class="event-hours-text">
          <text>OPEN HOURS</text>
          <text>{{activity.openTime}}-{{activity.closeTime}}</text>
        </view>
        <image wx:else class="event-hours-image" src="/assets/hours.png" mode="widthFix" aria-label="OPEN HOURS 11:00-20:00"></image>
      </view>

      <image wx:if="{{activity.coverUrl && activity.exhibitUrl && activity.coverUrl !== activity.exhibitUrl}}" class="exhibition-art" src="{{activity.exhibitUrl}}" mode="widthFix"></image>

      <view class="appointment-form">
        <view class="section-heading">
          <text class="heading-cn">请填写预约信息</text>
          <text class="heading-en">APPOINTMENT DETAILS</text>
        </view>

        <view class="form-field">
          <view class="field-caption">
            <text class="field-cn">姓名</text>
            <text class="field-en">YOUR NAME</text>
          </view>
          <input class="field-input" value="{{name}}" data-field="name" bindinput="onInput" maxlength="30" cursor-spacing="24" disabled="{{isSubmitting}}" />
        </view>

        <view class="form-field">
          <view class="field-caption">
            <text class="field-cn">手机号码</text>
            <text class="field-en">PHONE NUMBER</text>
          </view>
          <input class="field-input" value="{{phone}}" data-field="phone" bindinput="onInput" type="number" maxlength="11" cursor-spacing="24" disabled="{{isSubmitting}}" />
        </view>

        <view class="picker-row">
          <button class="picker-field" data-picker="date" bindtap="openPicker">
            <view class="field-caption">
              <text class="field-cn">选择日期</text>
              <text class="field-en">DATE</text>
            </view>
            <view class="picker-line">
              <text class="picker-result {{dateText ? 'picker-result--filled' : ''}}">{{dateText}}</text>
              <image class="picker-chevron" src="/assets/picker-chevron.svg" mode="aspectFit"></image>
            </view>
          </button>

          <button class="picker-field" data-picker="time" bindtap="openPicker">
            <view class="field-caption">
              <text class="field-cn">选择时间</text>
              <text class="field-en">TIME SLOT</text>
            </view>
            <view class="picker-line">
              <text class="picker-result {{selectedTime ? 'picker-result--filled' : ''}}">{{selectedTime}}</text>
              <image class="picker-chevron" src="/assets/picker-chevron.svg" mode="aspectFit"></image>
            </view>
          </button>
        </view>

        <view class="consent-row" bindtap="toggleConsent">
          <button class="consent-toggle" catchtap="toggleConsent" disabled="{{isSubmitting}}" hover-class="none" aria-label="同意隐私说明" aria-pressed="{{consented}}">
            <view class="checkbox {{consented ? 'checkbox--checked' : ''}}"></view>
          </button>
          <view class="consent-copy">
            <text>ARCHIVISM Gallery Store 仅会出于活动预约的目的收集并处理您的个人信息(包括微信号及活动互动数据)， 并采取合理的安全措施对信息进行保护，该等信息将在活动预约的必要范围内遵循法律规定进行存储。详细信息请参阅</text><button class="privacy-link" catchtap="openPrivacyPolicy" hover-class="none" aria-label="查看隐私政策">隐私政策</button><text>。</text>
          </view>
        </view>

        <button class="submit-button" bindtap="submitReservation" loading="{{isSubmitting}}" disabled="{{isSubmitting || !consented}}">提交</button>
        <button class="my-bookings-button" bindtap="openMyBookings" disabled="{{isSubmitting}}">我的预约</button>
      </view>
    </view>
  </view>

  <block wx:if="{{view === 'bookings'}}"><template is="booking-list" data="{{bookings, isBookingRoot, showBookingSuccess, hasQueriedBookings, bookingError, isLoadingBookings, isCancelling}}"></template></block>
  <template is="booking-cancel-dialog" data="{{showCancelDialog, cancelTarget, isCancelling}}"></template>

  <view wx:if="{{view === 'error'}}" class="page-body error-page">
    <view class="error-card">
      <text class="error-title">预约服务暂不可用</text>
      <text class="error-message">{{errorMessage}}</text>
      <button class="retry-button" bindtap="retryInitialize">重新加载</button>
    </view>
  </view>

  <view wx:if="{{showPolicy}}" class="dialog-mask" catchtap="closePrivacyPolicy">
    <view class="dialog-card policy-dialog" catchtap="noop" role="dialog" aria-modal="true" aria-label="隐私政策">
      <view class="policy-header">
        <text class="dialog-title policy-title">隐私政策</text>
        <button class="policy-close" bindtap="closePrivacyPolicy" aria-label="关闭隐私政策"><view class="close-icon"></view></button>
      </view>
      <scroll-view class="policy-content" scroll-y>
        <view class="policy-copy">
          <rich-text wx:if="{{policyContent && policyIsRichText}}" nodes="{{policyContent}}" user-select></rich-text>
          <text wx:elif="{{policyContent}}" class="policy-text" user-select>{{policyContent}}</text>
          <text wx:else class="policy-empty">隐私政策暂未配置，请联系活动方。</text>
        </view>
      </scroll-view>
      <button class="policy-confirm" bindtap="closePrivacyPolicy">我知道了</button>
    </view>
  </view>
</view>
