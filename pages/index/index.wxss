.app-shell {
  min-height: 100vh;
  background: #fff;
  color: #080808;
}

.page-body {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
}

.loading-page {
  overflow: hidden;
  background: #000;
}

.success-art {
  width: 100%;
  height: 100%;
}

.loading-art {
  width: 100%;
  height: 100%;
}

.main-scroll,
.subpage-scroll {
  height: auto;
  background: #fff;
}

.main-content {
  min-height: 100%;
  background: #fff;
}

/* Keep the form mounted throughout loading and native page navigation. */
.main-scroll--inactive {
  visibility: hidden;
  pointer-events: none;
}

.exhibition-art {
  display: block;
  width: 100%;
}

.event-intro {
  box-sizing: border-box;
  padding: 198rpx 0 0;
  text-align: center;
}

.event-title-image {
  display: block;
  width: 614rpx;
  margin: 0 auto;
}

.event-hours-image {
  display: block;
  width: 214rpx;
  margin: 38rpx auto 0;
}

.appointment-form {
  box-sizing: border-box;
  padding: 174rpx 74rpx 74rpx;
}

.section-heading {
  text-align: center;
}

.heading-cn,
.heading-en,
.field-cn,
.field-en,
.month-label,
.success-cn,
.success-en {
  display: block;
}

.heading-cn {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.22;
}

.heading-en {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.appointment-form .heading-cn {
  font-size: 40rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.appointment-form .heading-en {
  margin-top: 6rpx;
  line-height: 28rpx;
}

.form-field {
  margin-top: 142rpx;
}

.form-field + .form-field {
  margin-top: 80rpx;
}

.field-caption {
  color: #6a6a6a;
  font-weight: 300;
  text-align: left;
}

.field-cn {
  font-size: 24rpx;
  line-height: 28rpx;
}

.field-en {
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 300;
  line-height: 24rpx;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 66rpx;
  padding: 12rpx 0 0;
  border-bottom: 1rpx solid #b7b7b7;
  color: #050505;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 34rpx;
}

.picker-row {
  display: flex;
  gap: 14rpx;
  margin-top: 80rpx;
}

.picker-field {
  flex: 1;
  min-width: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.picker-line {
  position: relative;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  height: 66rpx;
  border-bottom: 1rpx solid #b7b7b7;
}

.picker-result {
  display: block;
  max-width: calc(100% - 38rpx);
  padding-bottom: 8rpx;
  overflow: hidden;
  color: transparent;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-result--filled {
  color: #050505;
}

.picker-chevron {
  position: absolute;
  right: 0;
  bottom: 14rpx;
  width: 16.3536px;
  height: 8.53033px;
  transform: rotate(180deg);
}

.consent-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
  min-height: 128rpx;
  margin-top: 144rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.consent-toggle {
  flex: 0 0 auto;
  width: 28rpx;
  height: 32rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  line-height: 32rpx;
}

.consent-toggle[disabled] {
  background: transparent;
  opacity: 0.6;
}

.checkbox {
  flex: 0 0 auto;
  box-sizing: border-box;
  width: 28rpx;
  height: 28rpx;
  margin-top: 2rpx;
  border: 1rpx solid #1f1f1f;
  background: #fff;
}

.checkbox--checked {
  background: #000;
}

.consent-copy {
  display: block;
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
  color: #000;
  font-size: 20rpx;
  font-weight: 300;
  line-height: 32rpx;
  white-space: normal;
}

.privacy-link {
  display: inline;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #111;
  font-size: inherit;
  font-weight: 300;
  line-height: inherit;
  vertical-align: baseline;
  text-decoration: underline;
}

.submit-button {
  width: 100%;
  height: 94rpx;
  margin-top: 70rpx;
  border-radius: 0;
  background: #000;
  color: #fff;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 94rpx;
}

.appointment-form .submit-button {
  height: 90rpx;
  margin-top: 88rpx;
  font-size: 24rpx;
  line-height: 90rpx;
}

.appointment-form .submit-button[disabled] {
  background: #deded9;
  color: #8d8d86;
}

.appointment-form .my-bookings-button {
  margin-top: 114rpx;
}

.subpage-fixed,
.subpage-scroll {
  background: #fff;
}

.picker-page {
  display: flex;
  flex-direction: column;
  background: #fff;
}

.picker-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.picker-actions {
  flex-shrink: 0;
  padding: 24rpx 74rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.picker-actions .outline-confirm {
  margin: 0;
}

.subpage {
  box-sizing: border-box;
  min-height: 100%;
  padding: 56rpx 74rpx 70rpx;
  background: #fff;
}

.close-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  margin: 13rpx;
}

.close-icon::before,
.close-icon::after {
  position: absolute;
  top: 18rpx;
  left: 0;
  width: 42rpx;
  border-top: 3rpx solid #777;
  content: '';
}

.close-icon::before {
  transform: rotate(45deg);
}

.close-icon::after {
  transform: rotate(-45deg);
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 160rpx;
  padding-bottom: 17rpx;
  border-bottom: 1rpx solid #777;
}

.week-label {
  color: #747474;
  font-size: 24rpx;
  font-weight: 300;
  text-align: center;
}

.month-block {
  margin-top: 70rpx;
}

.month-label {
  margin-bottom: 32rpx;
  font-size: 30rpx;
  font-weight: 400;
  text-align: center;
}

.date-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 24rpx;
}

.date-cell {
  justify-self: center;
  width: 48rpx;
  height: 48rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #111;
  font-size: 28rpx;
  font-weight: 300;
  line-height: 48rpx;
}

.date-cell--placeholder {
  visibility: hidden;
}

.date-cell--disabled {
  color: #d8d8d8;
}

.date-cell--selected {
  background: #dedede;
}

.outline-confirm {
  width: 100%;
  height: 90rpx;
  margin-top: 78rpx;
  border: 1rpx solid #222;
  border-radius: 0;
  background: #fff;
  color: #050505;
  font-size: 28rpx;
  line-height: 90rpx;
}

.time-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  column-gap: 28rpx;
  row-gap: 140rpx;
  margin-top: 200rpx;
}

.time-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 124rpx;
  padding: 24rpx 10rpx;
  border-radius: 0;
  background: transparent;
  color: #111;
  font-size: 25rpx;
  font-weight: 300;
  line-height: 36rpx;
  white-space: nowrap;
}

.time-cell--disabled,
.time-cell[disabled] {
  background: #f6f6f4;
  color: #a3a39d;
}

.time-cell--selected {
  border-bottom: 1rpx solid #111;
}

.success-page {
  height: auto;
  background: #050505;
}

.success-canvas {
  position: relative;
  min-height: 1436rpx;
  overflow: hidden;
}

.success-art {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.success-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  color: #fff;
  text-align: center;
}

/* Figma 13:913: positions within the 375 x 718 area below navigation. */
.success-title-image {
  position: absolute;
  top: 40.1114%;
  left: 50%;
  display: block;
  width: 614rpx;
  filter: invert(1);
  transform: translateX(-50%);
}

.success-details {
  position: absolute;
  top: 53.3426%;
  right: 6%;
  left: 6%;
  display: flex;
  flex-direction: column;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.address {
  width: 100%;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  text-decoration: underline;
}

.address:active,
.venue-address:active {
  opacity: 0.65;
}

.venue-address {
  width: 100%;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
  text-decoration: underline;
}

.success-status {
  position: absolute;
  top: 62.8134%;
  right: 6%;
  left: 6%;
}

.success-cn {
  font-size: 40rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.success-en {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.success-more-label {
  position: absolute;
  top: 77.2981%;
  left: 50%;
  font-size: 24rpx;
  font-weight: 300;
  line-height: 28rpx;
  transform: translateX(-50%);
}

.success-contacts {
  position: absolute;
  top: 82.0334%;
  left: 50%;
  display: flex;
  flex-direction: column;
  width: auto;
  max-width: calc(100% - 80rpx);
  transform: translateX(-50%);
}

.success-contact {
  display: flex;
  flex-wrap: nowrap;
  align-items: flex-start;
  gap: 12rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #fff;
  font-size: 16rpx;
  font-weight: 400;
  line-height: 20rpx;
  text-align: left;
}

.success-contact + .success-contact {
  margin-top: 34rpx;
}

.contact-label {
  flex: 0 0 88rpx;
  min-width: 0;
  font-weight: 500;
  text-align: right;
  white-space: nowrap;
}

.contact-value {
  flex: 0 0 auto;
  min-width: 0;
  white-space: nowrap;
  overflow-wrap: normal;
  word-break: normal;
}

.error-page {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 72rpx;
  background: #fff;
}

.error-card {
  width: 100%;
  text-align: center;
}

.error-title,
.error-message {
  display: block;
}

.error-title {
  font-size: 38rpx;
  font-weight: 700;
}

.error-message {
  margin-top: 24rpx;
  color: #666;
  font-size: 25rpx;
  line-height: 1.7;
}

.retry-button {
  width: 100%;
  height: 90rpx;
  margin-top: 70rpx;
  border-radius: 0;
  background: #000;
  color: #fff;
  font-size: 28rpx;
  line-height: 90rpx;
}

.event-hours-text text {
  display: block;
}

.event-hours-text {
  height: 64rpx;
  margin-top: 38rpx;
  font-family: "Zalando Sans Expanded", Arial, sans-serif;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.event-information {
  padding: 0 74rpx 70rpx;
}

.information-title,
.information-copy {
  display: block;
  white-space: pre-wrap;
  overflow-wrap: break-word;
}

.information-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.6;
}

.information-copy {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.8;
}

.notice-block {
  margin-top: 38rpx;
}

.text-action,
.my-bookings-button,
.success-action {
  margin: 24rpx 0 0;
  padding: 0;
  background: transparent;
  color: #111;
  font-size: 25rpx;
  line-height: 1.8;
  text-decoration: underline;
  overflow-wrap: break-word;
}

.event-information .text-action {
  text-align: left;
}

.state-message,
.date-legend {
  display: block;
  margin-top: 42rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 1.8;
  text-align: center;
}

.state-message--error {
  color: #a32929;
}

.outline-confirm[disabled] {
  border-color: #ccc;
  color: #aaa;
}

.slot-status {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}

.success-action {
  color: #fff;
}

.success-refresh {
  position: absolute;
  top: 24rpx;
  right: 8%;
  left: 8%;
  padding: 16rpx;
  background: rgba(0, 0, 0, 0.6);
  font-size: 20rpx;
  line-height: 1.4;
}

.bookings-scroll {
  height: auto;
  background: #f7f7f5;
}

.bookings-page {
  box-sizing: border-box;
  min-height: 100%;
  padding: 78rpx 40rpx 64rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.bookings-eyebrow,
.bookings-title,
.bookings-subtitle,
.booking-date,
.booking-time,
.bookings-state-eyebrow,
.bookings-state-title,
.bookings-state-copy {
  display: block;
}

.bookings-eyebrow {
  color: #6c6c68;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 28rpx;
  letter-spacing: 5rpx;
}

.bookings-title {
  margin-top: 16rpx;
  font-size: 56rpx;
  font-weight: 500;
  line-height: 76rpx;
  letter-spacing: 3rpx;
}

.bookings-heading-rule {
  width: 48rpx;
  height: 3rpx;
  margin-top: 28rpx;
  background: #151515;
}

.bookings-subtitle {
  margin-top: 24rpx;
  color: #777772;
  font-size: 24rpx;
  line-height: 38rpx;
}

.bookings-list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 66rpx 0 24rpx;
  font-size: 24rpx;
  line-height: 34rpx;
}

.bookings-count {
  color: #8a8a84;
  font-size: 22rpx;
}

.booking-card {
  margin-top: 24rpx;
  padding: 0 32rpx 32rpx;
  border: 1rpx solid #e3e3df;
  border-top: 4rpx solid #191919;
  background: #fff;
}

.booking-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eeeeea;
}

.booking-card-caption {
  color: #7b7b75;
  font-size: 18rpx;
  line-height: 28rpx;
  letter-spacing: 2rpx;
}

.booking-status {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10rpx;
  color: #888882;
  font-size: 22rpx;
  line-height: 32rpx;
}

.booking-status--active {
  color: #1b1b18;
}

.booking-status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.booking-schedule {
  padding: 34rpx 0 32rpx;
}

.booking-date {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.booking-time {
  margin-top: 6rpx;
  font-family: Arial, sans-serif;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 64rpx;
  letter-spacing: 1rpx;
}

.booking-information {
  padding: 26rpx 0;
  border-top: 1rpx dashed #deded9;
}

.booking-information-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  font-size: 24rpx;
  line-height: 38rpx;
}

.booking-information-row + .booking-information-row {
  margin-top: 14rpx;
}

.booking-label {
  flex-shrink: 0;
  color: #898983;
}

.booking-value {
  min-width: 0;
  text-align: right;
  overflow-wrap: break-word;
  word-break: break-all;
}

.booking-reference {
  padding-top: 2rpx;
  color: #6d6d67;
  font-family: Arial, sans-serif;
  font-size: 22rpx;
}

.booking-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.booking-button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  min-height: 84rpx;
  margin: 0;
  padding: 18rpx 16rpx;
  border: 1rpx solid #c9c9c3;
  border-radius: 0;
  background: #fff;
  color: #575751;
  font-size: 24rpx;
  line-height: 36rpx;
}

.booking-button--primary {
  border-color: #191919;
  background: #191919;
  color: #fff;
}

.booking-button[disabled] {
  border-color: #deded9;
  background: #efefeb;
  color: #a3a39b;
}

.booking-button:active {
  opacity: 0.7;
}

.bookings-state {
  padding: 86rpx 32rpx;
  border: 1rpx solid #e3e3df;
  background: #fff;
  text-align: center;
}

.bookings-state-eyebrow {
  margin-bottom: 24rpx;
  color: #8a8a84;
  font-size: 18rpx;
  line-height: 28rpx;
  letter-spacing: 3rpx;
}

.bookings-state-title {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.bookings-state-copy {
  margin-top: 18rpx;
  color: #888882;
  font-size: 24rpx;
  line-height: 40rpx;
  overflow-wrap: break-word;
}

.bookings-state-button {
  width: 264rpx;
  margin: 40rpx auto 0;
}

.bookings-empty-mark {
  box-sizing: border-box;
  width: 72rpx;
  height: 76rpx;
  margin: 0 auto 32rpx;
  padding: 26rpx 16rpx 0;
  border: 1rpx solid #b5b5ac;
  border-top: 8rpx solid #b5b5ac;
}

.bookings-empty-mark view {
  height: 1rpx;
  margin-bottom: 12rpx;
  background: #d4d4cb;
}

.bookings-loading-mark {
  width: 36rpx;
  height: 36rpx;
  margin: 0 auto 30rpx;
  border: 3rpx solid #e8e8e3;
  border-top-color: #33332e;
  border-radius: 50%;
  animation: bookings-spin 0.8s linear infinite;
}

@keyframes bookings-spin {
  to { transform: rotate(360deg); }
}

.bookings-footer {
  padding-top: 44rpx;
  color: #96968e;
  font-size: 21rpx;
  line-height: 34rpx;
  text-align: center;
}

.bookings-footer-rule {
  width: 30rpx;
  height: 1rpx;
  margin: 0 auto 20rpx;
  background: #c5c5bc;
}

.dialog-actions {
  display: flex;
  gap: 30rpx;
}

.dialog-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50rpx;
  background: rgba(0, 0, 0, 0.55);
}

.dialog-card {
  box-sizing: border-box;
  width: 100%;
  max-height: 85vh;
  padding: 40rpx;
  background: #fff;
  color: #111;
}

.dialog-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.dialog-actions button {
  flex: 1;
  margin-top: 36rpx;
  font-size: 25rpx;
}

.policy-dialog {
  max-height: 80vh;
  border-radius: 16rpx;
}

.policy-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.policy-title {
  margin: 0;
  font-size: 32rpx;
  line-height: 48rpx;
}

.policy-close {
  width: 64rpx;
  height: 64rpx;
  margin: -12rpx -12rpx -12rpx 0;
  padding: 0;
  background: transparent;
}

.policy-content {
  height: 45vh;
}

.policy-copy {
  padding: 0 4rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.8;
  overflow-wrap: break-word;
}

.policy-text {
  white-space: pre-wrap;
}

.policy-empty {
  color: #777;
}

