.app-shell {
  min-height: 100vh;
  background: #fff;
  color: #080808;
}

.topbar {
  position: fixed;
  z-index: 50;
  top: 0;
  right: 0;
  left: 0;
  box-sizing: border-box;
  background: #fff;
}

.nav-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.nav-title {
  max-width: 440rpx;
  overflow: hidden;
  color: #050505;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  width: 68rpx;
  height: 68rpx;
  padding: 0;
  transform: translateY(-50%);
  background: transparent;
}

.back-chevron,
.thin-chevron {
  width: 25rpx;
  height: 25rpx;
  border-bottom: 4rpx solid #171717;
  border-left: 4rpx solid #171717;
  transform: rotate(45deg);
}

.back-chevron {
  margin-left: 18rpx;
}

.page-body {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
}

.loading-page {
  overflow: hidden;
  background: #000;
}

.loading-art,
.success-art {
  width: 100%;
  height: 100%;
}

.main-scroll,
.subpage-scroll {
  height: auto;
  background: #fff;
}

.main-content {
  min-height: 100%;
  background: #fff;
}

.exhibition-art {
  display: block;
  width: 100%;
}

.event-intro {
  box-sizing: border-box;
  height: 500rpx;
  padding-top: 178rpx;
  text-align: center;
}

.event-title-image {
  display: block;
  width: 82%;
  margin: 0 auto;
}

.event-hours-image {
  display: block;
  width: 32%;
  margin: 57rpx auto 0;
}

.appointment-form {
  box-sizing: border-box;
  min-height: 1470rpx;
  padding: 40rpx 74rpx 74rpx;
}

.section-heading {
  text-align: center;
}

.heading-cn,
.heading-en,
.field-cn,
.field-en,
.month-label,
.success-cn,
.success-en {
  display: block;
}

.heading-cn {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.22;
}

.heading-en {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.form-field {
  margin-top: 132rpx;
}

.form-field + .form-field {
  margin-top: 78rpx;
}

.field-caption {
  color: #343434;
  text-align: left;
}

.field-cn {
  font-size: 28rpx;
  line-height: 1.2;
}

.field-en {
  margin-top: 3rpx;
  font-size: 22rpx;
  font-weight: 300;
  line-height: 1.2;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  padding: 12rpx 0 0;
  border-bottom: 1rpx solid #393939;
  color: #050505;
  font-size: 30rpx;
  font-weight: 600;
}

.phone-input-row {
  display: flex;
  align-items: flex-end;
  border-bottom: 1rpx solid #393939;
}

.phone-input {
  flex: 1;
  min-width: 0;
  border-bottom: 0;
}

.phone-auth-button {
  flex: 0 0 auto;
  min-width: 132rpx;
  height: 64rpx;
  margin: 0 0 8rpx 18rpx;
  padding: 0 12rpx;
  border: 1rpx solid #222;
  border-radius: 0;
  background: #fff;
  color: #111;
  font-size: 22rpx;
  line-height: 62rpx;
}

.picker-row {
  display: flex;
  gap: 14rpx;
  margin-top: 80rpx;
}

.picker-field {
  flex: 1;
  min-width: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.picker-line {
  position: relative;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  height: 78rpx;
  border-bottom: 1rpx solid #393939;
}

.picker-result {
  display: block;
  max-width: calc(100% - 50rpx);
  padding-bottom: 12rpx;
  overflow: hidden;
  color: transparent;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-result--filled {
  color: #050505;
}

.down-chevron {
  position: absolute;
  right: 8rpx;
  bottom: 21rpx;
  width: 22rpx;
  height: 22rpx;
  border-right: 2rpx solid #7a7a7a;
  border-bottom: 2rpx solid #7a7a7a;
  transform: rotate(45deg);
}

.consent-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
  margin-top: 122rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.checkbox {
  flex: 0 0 auto;
  box-sizing: border-box;
  width: 32rpx;
  height: 32rpx;
  margin-top: 4rpx;
  border: 1rpx solid #1f1f1f;
  background: #fff;
}

.checkbox--checked {
  background: #000;
}

.consent-copy {
  margin-left: 10rpx;
  color: #333;
  font-size: 19rpx;
  font-weight: 300;
  line-height: 1.65;
}

.privacy-link {
  color: #111;
  font-weight: 500;
  text-decoration: underline;
}

.submit-button {
  width: 100%;
  height: 94rpx;
  margin-top: 70rpx;
  border-radius: 0;
  background: #000;
  color: #fff;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 94rpx;
}

.subpage-fixed,
.subpage-scroll {
  background: #fff;
}

.subpage {
  box-sizing: border-box;
  min-height: 100%;
  padding: 0 74rpx 70rpx;
  background: #fff;
}

.subpage-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 116rpx;
}

.subpage-back,
.subpage-close {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  background: transparent;
}

.thin-chevron {
  margin: 17rpx 0 0 12rpx;
  border-width: 3rpx;
  border-color: #777;
}

.close-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  margin: 13rpx;
}

.close-icon::before,
.close-icon::after {
  position: absolute;
  top: 18rpx;
  left: 0;
  width: 42rpx;
  border-top: 3rpx solid #777;
  content: '';
}

.close-icon::before {
  transform: rotate(45deg);
}

.close-icon::after {
  transform: rotate(-45deg);
}

.subpage-heading {
  margin-top: 18rpx;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 160rpx;
  padding-bottom: 17rpx;
  border-bottom: 1rpx solid #777;
}

.week-label {
  color: #747474;
  font-size: 24rpx;
  font-weight: 300;
  text-align: center;
}

.month-block {
  margin-top: 70rpx;
}

.month-label {
  margin-bottom: 32rpx;
  font-size: 30rpx;
  font-weight: 400;
  text-align: center;
}

.date-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 24rpx;
}

.date-cell {
  justify-self: center;
  width: 48rpx;
  height: 48rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #111;
  font-size: 28rpx;
  font-weight: 300;
  line-height: 48rpx;
}

.date-cell--placeholder {
  visibility: hidden;
}

.date-cell--disabled {
  color: #d8d8d8;
}

.date-cell--selected {
  background: #dedede;
}

.outline-confirm {
  width: 100%;
  height: 90rpx;
  margin-top: 78rpx;
  border: 1rpx solid #222;
  border-radius: 0;
  background: #fff;
  color: #050505;
  font-size: 28rpx;
  line-height: 90rpx;
}

.time-page {
  height: 100%;
}

.time-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  column-gap: 28rpx;
  row-gap: 140rpx;
  margin-top: 200rpx;
}

.time-cell {
  height: 54rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #111;
  font-size: 25rpx;
  font-weight: 300;
  line-height: 54rpx;
  white-space: nowrap;
}

.time-cell--disabled {
  color: #ddd;
}

.time-cell--selected {
  border-bottom: 1rpx solid #111;
}

.time-confirm {
  margin-top: 200rpx;
}

.success-page {
  overflow: hidden;
  background: #050505;
}

.success-art {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.success-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 0 58rpx;
  color: #fff;
  text-align: center;
}

.success-title-image {
  display: block;
  width: 82%;
  margin: 545rpx auto 0;
  filter: invert(1);
}

.success-details {
  display: flex;
  flex-direction: column;
  margin-top: 55rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.45;
}

.address {
  text-decoration: underline;
}

.success-status {
  margin-top: 58rpx;
}

.success-cn {
  font-size: 38rpx;
  font-weight: 700;
}

.success-en {
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.cancel-button {
  margin-top: 220rpx;
  padding: 0;
  background: transparent;
  color: #fff;
  font-size: 31rpx;
  font-weight: 500;
}

.cancel-chevron {
  margin-right: 8rpx;
  font-size: 39rpx;
  font-weight: 300;
  vertical-align: -2rpx;
}

.error-page {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 72rpx;
  background: #fff;
}

.error-card {
  width: 100%;
  text-align: center;
}

.error-title,
.error-message {
  display: block;
}

.error-title {
  font-size: 38rpx;
  font-weight: 700;
}

.error-message {
  margin-top: 24rpx;
  color: #666;
  font-size: 25rpx;
  line-height: 1.7;
}

.retry-button {
  width: 100%;
  height: 90rpx;
  margin-top: 70rpx;
  border-radius: 0;
  background: #000;
  color: #fff;
  font-size: 28rpx;
  line-height: 90rpx;
}
