<import src="../../templates/bookings.wxml" />
<import src="../../templates/success.wxml" />
<import src="../../templates/loading.wxml" />
<page-meta page-style="background-color: {{view === 'bookings' ? '#f7f7f5' : '#050505'}};"></page-meta>
<view class="app-shell {{view === 'success' ? 'reservation-shell--dark' : ''}}">
  <template is="startup-loading" data="{{showStartupLoading, startupLoadingFading}}"></template>
  <view wx:if="{{view === 'loading'}}" class="page-body loading-page">
    <image class="loading-art" src="/assets/loading.png" mode="aspectFill" aria-label="GUCCI BY TOM FORD"></image>
  </view>

  <scroll-view wx:if="{{view === 'success'}}" class="page-body success-page" scroll-y>
    <template is="success-content" data="{{activity, reservation, venueAddress, detailError, isRefreshing, successArtSrc, successTitleSrc}}"></template>
  </scroll-view>

  <block wx:elif="{{view === 'bookings'}}"><template is="booking-list" data="{{bookings, isBookingRoot, showBookingSuccess, hasQueriedBookings, bookingError, isLoadingBookings, isCancelling}}"></template></block>

  <template is="booking-cancel-dialog" data="{{showCancelDialog, cancelTarget, isCancelling}}"></template>

</view>
